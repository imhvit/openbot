{
  "name": "openbot",
  "version": "0.0.1",
  "description": "Bot de Discord",
  "main": "dist/bot.js",
  "exports": {
    ".": "./dist/bot.js"
  },
  "scripts": {
    "build": "tsup && tsc-alias",
    "dev": "tsx watch src/bot.ts",
    "start": "node dist/bot.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "discord",
    "bot",
    "discord.js"
  ],
  "author": "imhvit",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "chalk": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "pg": "^8.22.0",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
